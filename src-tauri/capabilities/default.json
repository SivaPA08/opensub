{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-home-read-recursive",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/opensub-ffmpeg",
          "sidecar": true
        },
        {
          "name": "binaries/opensub-ffprobe",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/opensub-ffmpeg",
          "sidecar": true
        },
        {
          "name": "binaries/opensub-ffprobe",
          "sidecar": true
        }
      ]
    }
  ]
}